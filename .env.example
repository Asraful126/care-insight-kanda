# Copy to .env (git-ignored) and fill in. Never commit real values.
ANTHROPIC_API_KEY=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
# Fabric (names, not secrets)
FABRIC_WORKSPACE=kanda-care-insights
FABRIC_LAKEHOUSE=lh_care_insights
# SQL analytics endpoint host (xxxx.datawarehouse.fabric.microsoft.com) and database (= lakehouse name)
FABRIC_SQL_ENDPOINT=
FABRIC_SQL_DATABASE=lh_care_insights
# Assistant's reader identity, sp-care-insights-reader (local runs and eval; Azure uses a managed identity)
READER_CLIENT_ID=
READER_CLIENT_SECRET=
# Semantic model's OneLake identity, sp-care-insights-model (scripts/deploy_semantic_model.py)
MODEL_CLIENT_ID=
MODEL_CLIENT_SECRET=
# Optional: access code for the chat page (set in Azure as a Container Apps secret)
APP_ACCESS_CODE=
