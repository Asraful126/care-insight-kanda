/// Same grain as plans. Provider counts are not additive across regions or cohorts.
table fact_ndis_providers

	/// Active NDIS providers, as published. One provider serves many regions and cohorts, so counts don't add up:
	/// BLANK when the slice covers more than one published cell.
	measure 'Active providers' =
			// Published-cell rule (data dictionary decision 2):
			// - cohort dimension not filtered -> its ALL row; filtered -> its detail rows
			// - region: the coarsest region type in the current filter context (national when nothing is filtered)
			// - date: the latest report date in context (counts are quarter-end snapshots, never added over time)
			VAR _dgAll = NOT ISFILTERED ( dim_disability_group )
			VAR _abAll = NOT ISFILTERED ( dim_age_band )
			VAR _scAll = NOT ISFILTERED ( dim_support_class )
			VAR _level = CALCULATE ( MIN ( dim_region[region_type_order] ), fact_ndis_providers )
			VAR _date = MAX ( fact_ndis_providers[date_key] )
			VAR _cells =
				CALCULATETABLE (
					fact_ndis_providers,
					KEEPFILTERS ( dim_region[region_type_order] = _level ),
					KEEPFILTERS ( dim_date[date_key] = _date ),
					KEEPFILTERS ( dim_disability_group[is_all] = _dgAll ),
					KEEPFILTERS ( dim_age_band[is_all] = _abAll ),
					KEEPFILTERS ( dim_support_class[is_all] = _scAll )
				)
			RETURN
				// Not additive: show only when exactly one published cell matches; several cells -> BLANK
				IF ( COUNTROWS ( _cells ) = 1, MAXX ( _cells, fact_ndis_providers[provider_count] ) )
		formatString: #,0
		displayFolder: NDIS

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: date_key

	column report_date
		dataType: dateTime
		isHidden
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: report_date

	column disability_group
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: disability_group

	column age_band
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: age_band

	column support_class
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: support_class

	column is_all_disability_group
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: is_all_disability_group

	column is_all_age_band
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: is_all_age_band

	column is_all_support_class
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: is_all_support_class

	column region_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: region_key

	column provider_count
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: provider_count

	column provider_count_is_suppressed
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: provider_count_is_suppressed

	column provider_count_upper_bound
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: provider_count_upper_bound

	column _gold_loaded_at
		dataType: dateTime
		isHidden
		formatString: General Date
		summarizeBy: none
		sourceColumn: _gold_loaded_at

	column _gold_run_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: _gold_run_id

	partition fact_ndis_providers = entity
		mode: directLake
		source
			entityName: fact_ndis_providers
			schemaName: kanda_gold
			expressionSource: 'DirectLake - lh_care_insights'

