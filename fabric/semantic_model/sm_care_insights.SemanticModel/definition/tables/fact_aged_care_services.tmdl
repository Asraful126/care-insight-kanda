/// Grain: period end x program x region x care level. HCP is a stock, CHSP a flow: never add across programs.
table fact_aged_care_services

	/// People in a Home Care Package on 30 June (a stock). Never add to CHSP.
	measure 'HCP people' =
			// Region: the single aged-care region type in context if there is one (e.g. a PHN visual), otherwise SA3.
			// PHN and ACPR cross state borders, so state totals by PHN/ACPR differ; SA3 = LGA in every state.
			// Date: the latest period in context. Care level: Total unless care_level is filtered (levels add up).
			VAR _careAll = NOT ISFILTERED ( fact_aged_care_services[care_level] )
			RETURN
				CALCULATE (
					VAR _types = CALCULATETABLE ( VALUES ( dim_region[region_type] ), fact_aged_care_services )
					VAR _type = IF ( COUNTROWS ( _types ) = 1, MAXX ( _types, dim_region[region_type] ), "SA3" )
					VAR _date = MAX ( fact_aged_care_services[date_key] )
					RETURN
						CALCULATE (
							SUM ( fact_aged_care_services[people] ),
							KEEPFILTERS ( dim_region[region_type] = _type ),
							KEEPFILTERS ( dim_date[date_key] = _date ),
							KEEPFILTERS ( fact_aged_care_services[is_all_care_level] = _careAll )
						),
					KEEPFILTERS ( fact_aged_care_services[program] = "HCP" )
				)
		formatString: #,0
		displayFolder: Aged care

	/// Distinct people served by CHSP during the financial year (a flow). Never add to HCP.
	measure 'CHSP people served' =
			// Region: the single aged-care region type in context if there is one (e.g. a PHN visual), otherwise SA3.
			// PHN and ACPR cross state borders, so state totals by PHN/ACPR differ; SA3 = LGA in every state.
			// Date: the latest period in context. Care level: Total unless care_level is filtered (levels add up).
			VAR _careAll = NOT ISFILTERED ( fact_aged_care_services[care_level] )
			RETURN
				CALCULATE (
					VAR _types = CALCULATETABLE ( VALUES ( dim_region[region_type] ), fact_aged_care_services )
					VAR _type = IF ( COUNTROWS ( _types ) = 1, MAXX ( _types, dim_region[region_type] ), "SA3" )
					VAR _date = MAX ( fact_aged_care_services[date_key] )
					RETURN
						CALCULATE (
							SUM ( fact_aged_care_services[people] ),
							KEEPFILTERS ( dim_region[region_type] = _type ),
							KEEPFILTERS ( dim_date[date_key] = _date ),
							KEEPFILTERS ( fact_aged_care_services[is_all_care_level] = _careAll )
						),
					KEEPFILTERS ( fact_aged_care_services[program] = "CHSP" )
				)
		formatString: #,0
		displayFolder: Aged care

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: date_key

	column period_end_date
		dataType: dateTime
		isHidden
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: period_end_date

	column period_label
		dataType: string
		summarizeBy: none
		sourceColumn: period_label

	column program
		dataType: string
		summarizeBy: none
		sourceColumn: program

	column program_name
		dataType: string
		summarizeBy: none
		sourceColumn: program_name

	column count_type
		dataType: string
		summarizeBy: none
		sourceColumn: count_type

	column region_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: region_key

	column care_level
		dataType: string
		summarizeBy: none
		sourceColumn: care_level

	column is_all_care_level
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: is_all_care_level

	column people
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: people

	column people_is_suppressed
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: people_is_suppressed

	column people_upper_bound
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: people_upper_bound

	column _gold_loaded_at
		dataType: dateTime
		isHidden
		formatString: General Date
		summarizeBy: none
		sourceColumn: _gold_loaded_at

	column _gold_run_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: _gold_run_id

	partition fact_aged_care_services = entity
		mode: directLake
		source
			entityName: fact_aged_care_services
			schemaName: kanda_gold
			expressionSource: 'DirectLake - lh_care_insights'

